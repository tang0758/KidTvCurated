# 复制成 .env 再修改：cp .env.example .env
# .env 含访问码，不会进 Git。
# 生成强访问码：python -c "import secrets;print(secrets.token_hex(12))"

KIDTV_TOKEN=
KIDTV_PORT=8765

# 只在通过反向代理访问时改成 1：绿联 UGREENlink 容器快捷方式 / Cloudflare Tunnel / Nginx
# 设成 1 后按 X-Forwarded-For 识别真实客户端来限速；直连或 Tailscale 保持 0
KIDTV_TRUST_PROXY=0

# 只有 docker-compose.tailscale.yml 需要：
# 在 https://login.tailscale.com/admin/settings/keys 生成一次性 auth key
# TS_AUTHKEY=tskey-auth-xxxxxxxx

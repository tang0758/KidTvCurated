<?xml version="1.0" encoding="utf-8"?>
<!-- 卡片底色。焦点边框改由 focus_ring.xml 盖在最上层绘制，这里不再画金边。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focus" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#33FFC44D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>

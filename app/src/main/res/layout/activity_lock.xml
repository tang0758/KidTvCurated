<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="60dp"
        android:paddingEnd="60dp">

        <TextView
            android:id="@+id/tvHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="现在不是看片时间"
            android:textColor="#F2F4F8"
            android:textSize="36sp"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="距离可以看还有"
            android:textColor="#9AA3B2"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="00:00:00"
            android:textColor="#FFC44D"
            android:textSize="112sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.02"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="到点啦，先去玩会儿别的吧"
            android:textColor="#C6CDD8"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天已看 0 分钟"
                android:textColor="#7C8797"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="    ·    "
                android:textColor="#7C8797"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="现在 00:00"
                android:textColor="#7C8797"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:text="按遥控器「菜单」键 · 家长临时放行"
            android:textColor="#5F6875"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>

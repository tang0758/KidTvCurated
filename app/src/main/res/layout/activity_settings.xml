<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="30dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="家长控制"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvScope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="设置会写回 NAS 的 tv.json"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="今天 0 分钟"
            android:textColor="@color/accent"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvNas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/pill_bg"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="NAS"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- OPT-07：写 NAS 失败时一直挂着的红色错误条，家长处理完才消失 -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#40E53935"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFCDD2"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="14dp" />

    <TextView
        android:id="@+id/tvBusy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="方向键选择 · OK 修改 · 返回键回到片单"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />
</LinearLayout>
